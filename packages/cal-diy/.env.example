# The calcom/cal.diy registry does not have a published image yet. This is the
# last official ARM64 image corresponding to the open-source v6.2.0 release.
CALDIY_IMAGE=calcom/cal.com:v6.2.0-arm
CALDIY_PORT=3001

POSTGRES_DB=calendso
POSTGRES_USER=caldiy
POSTGRES_PASSWORD=replace_with_a_random_hex_value

NEXT_PUBLIC_WEBAPP_URL=http://localhost:3001
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3001
NEXT_PUBLIC_EMBED_LIB_URL=http://localhost:3001/embed/embed.js
NEXTAUTH_URL=http://localhost:3001
ALLOWED_HOSTNAMES='"localhost:3001","127.0.0.1:3001"'

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_random_value

# Generate with: openssl rand -base64 24
CALENDSO_ENCRYPTION_KEY=replace_with_a_32_character_value

# Used to authenticate cron endpoints.
CRON_API_KEY=replace_with_a_random_hex_value

# Use this value as the secret when adding the Twenty booking webhook in
# Cal.diy. It must match CALDIY_WEBHOOK_SECRET in Agent Command Center settings.
CALDIY_TWENTY_WEBHOOK_SECRET=replace_with_a_random_hex_value

CALCOM_TELEMETRY_DISABLED=1
EMAIL_FROM=notifications@localhost
EMAIL_FROM_NAME=Cal.diy

# Optional integrations. Leave disabled until credentials are configured.
GOOGLE_LOGIN_ENABLED=false
# GOOGLE_API_CREDENTIALS={"web":{"client_id":"...","client_secret":"..."}}
OUTLOOK_LOGIN_ENABLED=false
